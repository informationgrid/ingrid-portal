{# Algorithmus #}
{# Informationen zum Algorithmus #}
{% set algInfo = infoRefs.algorithmType or infoRefs.algorithmTypeOfUse or infoRefs.algorithmExplanation or infoRefs.algorithmMethods|length > 0 or infoRefs.algorithmTrainingData or infoRefs.algorithmDataBias or infoRefs.algorithmErrorBias or infoRefs.algorithmMonitoring %}
{% if algInfo %}
    <div class="sub-section">
        <a class="anchor" id="{{ hash_info }}_technical_information"></a>
        {{ hit_macros.render_group_title("SEARCH_DETAIL.TECHNICAL_INFORMATION_7"|t) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_TYPE"|t, infoRefs.algorithmType) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_TYPE_OF_USE"|t, infoRefs.algorithmTypeOfUse) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_EXPLANATION"|t, infoRefs.algorithmExplanation) }}
        {{ hit_macros.render_label_text_list_row("SEARCH_DETAIL.ALG_METHODS"|t, infoRefs.algorithmMethods) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_TRAINING_DATA"|t, infoRefs.algorithmTrainingData) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_DATA_BIAS"|t, infoRefs.algorithmDataBias) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_ERROR_BIAS"|t, infoRefs.algorithmErrorBias) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_MONITORING"|t, infoRefs.algorithmMonitoring) }}
    </div>
{% endif %}
{# Input-Daten #}
{% set algorithmAttributeHeader = [
    "SEARCH_DETAIL.ALG_ATTRIBUTE_NAME"|t,
    "SEARCH_DETAIL.ALG_ATTRIBUTE_UNIT"|t,
    "SEARCH_DETAIL.ALG_ATTRIBUTE_SPATIAL_RESOLUTION"|t,
    "SEARCH_DETAIL.ALG_ATTRIBUTE_TEMPORAL_RESOLUTION"|t,
] %}
{% if infoRefs.algorithmInputData and infoRefs.algorithmInputData|length > 0 %}
    <div class="sub-section">
        <a class="anchor" id="{{ hash_info }}_alg_input_data"></a>
        {{ hit_macros.render_group_title("SEARCH_DETAIL.ALG_INPUT_DATA"|t) }}
        {% for data in infoRefs.algorithmInputData %}
            {{ hit_macros.render_entry_table(data.name, data.url, algorithmAttributeHeader, data.attributes) }}
        {% endfor %}
    </div>
{% endif %}
{# Output-Daten #}
{% if infoRefs.algorithmOutputData and infoRefs.algorithmOutputData|length > 0 %}
    <div class="sub-section">
        <a class="anchor" id="{{ hash_info }}_alg_output_data"></a>
        {{ hit_macros.render_group_title("SEARCH_DETAIL.ALG_OUTPUT_DATA"|t) }}
        {% for data in infoRefs.algorithmOutputData %}
            {{ hit_macros.render_entry_table(data.name, data.url, algorithmAttributeHeader, data.attributes) }}
        {% endfor %}
    </div>
{% endif %}
{# Links #}
{% set algLinks = infoRefs.algorithmApiUrl or infoRefs.algorithmSourceCodeUrl or infoRefs.algorithmWebsiteUrl or infoRefs.algorithmExampleUrl or infoRefs.algorithmPubliccodeUrl or infoRefs.algorithmAdditionalUrls|length > 0 %}
{% if algLinks %}
    <div class="sub-section">
        <a class="anchor" id="{{ hash_info }}_alg_links"></a>
        {{ hit_macros.render_group_title("SEARCH_DETAIL.ALG_LINKS"|t) }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_API_URL"|t, infoRefs.algorithmApiUrl, infoRefs.algorithmApiUrl, "external") }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_SOURCE_CODE_URL"|t, infoRefs.algorithmSourceCodeUrl, infoRefs.algorithmSourceCodeUrl, "external") }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_WEBSITE_URL"|t, infoRefs.algorithmWebsiteUrl, infoRefs.algorithmWebsiteUrl, "external") }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_EXAMPLE_URL"|t, infoRefs.algorithmExampleUrl, infoRefs.algorithmExampleUrl, "external") }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_PUBLICCODE_URL"|t, infoRefs.algorithmPubliccodeUrl, infoRefs.algorithmPubliccodeUrl, "external") }}
        {% for data in infoRefs.algorithmAdditionalUrls %}
            {{ hit_macros.render_label_link(data.name, data.url, data.url, "external") }}
        {% endfor %}
    </div>
{% endif %}