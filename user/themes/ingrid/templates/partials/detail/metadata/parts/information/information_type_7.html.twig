{# Algorithmus #}
{# Informationen zum Algorithmus #}
{% set algInfo = infoRefs.algorithmType or infoRefs.algorithmTypeOfUse or infoRefs.algorithmExplanation or infoRefs.algorithmMethods|length > 0 or infoRefs.algorithmTrainingData or infoRefs.algorithmDataBias or infoRefs.algorithmErrorBias or infoRefs.algorithmMonitoring %}
{% if algInfo %}
    <div class="sub-section">
        <a class="anchor" id="{{ hash_info }}_technical_information"></a>
        {{ hit_macros.render_group_title("SEARCH_DETAIL.TECHNICAL_INFORMATION_7"|t) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_TYPE"|t, infoRefs.algorithmType, null, null, null, "SEARCH_DETAIL.ALG_HELP.TYPE.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.TYPE.MESSAGE"|t) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_TYPE_OF_USE"|t, infoRefs.algorithmTypeOfUse, null, null, null, "SEARCH_DETAIL.ALG_HELP.TYPE_OF_USE.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.TYPE_OF_USE.MESSAGE"|t) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_EXPLANATION"|t, infoRefs.algorithmExplanation, null, null, null, "SEARCH_DETAIL.ALG_HELP.EXPLANATION.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.EXPLANATION.MESSAGE"|t) }}
        {{ hit_macros.render_label_text_list_row("SEARCH_DETAIL.ALG_METHODS"|t, infoRefs.algorithmMethods, null, null, null, null, "SEARCH_DETAIL.ALG_HELP.METHODS.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.METHODS.MESSAGE"|t) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_TRAINING_DATA"|t, infoRefs.algorithmTrainingData, null, null, null, "SEARCH_DETAIL.ALG_HELP.TRAINING_DATA.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.TRAINING_DATA.MESSAGE"|t) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_DATA_BIAS"|t, infoRefs.algorithmDataBias, null, null, null, "SEARCH_DETAIL.ALG_HELP.DATA_BIAS.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.DATA_BIAS.MESSAGE"|t) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_ERROR_BIAS"|t, infoRefs.algorithmErrorBias, null, null, null, "SEARCH_DETAIL.ALG_HELP.ERROR_BIAS.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.ERROR_BIAS.MESSAGE"|t) }}
        {{ hit_macros.render_label_text_row("SEARCH_DETAIL.ALG_MONITORING"|t, infoRefs.algorithmMonitoring, null, null, null, "SEARCH_DETAIL.ALG_HELP.MONITORING.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.MONITORING.MESSAGE"|t) }}
    </div>
{% endif %}
{# Input-Daten #}
{% set algorithmAttributeHeader = [
    "SEARCH_DETAIL.ALG_ATTRIBUTE_NAME"|t,
    "SEARCH_DETAIL.ALG_ATTRIBUTE_UNIT"|t,
    "SEARCH_DETAIL.ALG_ATTRIBUTE_SPATIAL_RESOLUTION"|t,
    "SEARCH_DETAIL.ALG_ATTRIBUTE_TEMPORAL_RESOLUTION"|t,
] %}
{% if infoRefs.algorithmInputData and infoRefs.algorithmInputData|length > 0 %}
    <div class="sub-section">
        <a class="anchor" id="{{ hash_info }}_alg_input_data"></a>
        {{ hit_macros.render_group_title("SEARCH_DETAIL.ALG_INPUT_DATA"|t, "SEARCH_DETAIL.ALG_HELP.INPUT_DATA.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.INPUT_DATA.MESSAGE"|t) }}
        {% for data in infoRefs.algorithmInputData %}
            {{ hit_macros.render_entry_table(data.name, data.url, algorithmAttributeHeader, data.attributes) }}
        {% endfor %}
    </div>
{% endif %}
{# Output-Daten #}
{% if infoRefs.algorithmOutputData and infoRefs.algorithmOutputData|length > 0 %}
    <div class="sub-section">
        <a class="anchor" id="{{ hash_info }}_alg_output_data"></a>
        {{ hit_macros.render_group_title("SEARCH_DETAIL.ALG_OUTPUT_DATA"|t, "SEARCH_DETAIL.ALG_HELP.OUTPUT_DATA.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.OUTPUT_DATA.MESSAGE"|t) }}
        {% for data in infoRefs.algorithmOutputData %}
            {{ hit_macros.render_entry_table(data.name, data.url, algorithmAttributeHeader, data.attributes) }}
        {% endfor %}
    </div>
{% endif %}
{# Links #}
{% set algLinks = infoRefs.algorithmApiUrl or infoRefs.algorithmSourceCodeUrl or infoRefs.algorithmWebsiteUrl or infoRefs.algorithmExampleUrl or infoRefs.algorithmPubliccodeUrl or infoRefs.algorithmAdditionalUrls|length > 0 %}
{% if algLinks %}
    <div class="sub-section">
        <a class="anchor" id="{{ hash_info }}_alg_links"></a>
        {{ hit_macros.render_group_title("SEARCH_DETAIL.ALG_LINKS"|t) }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_API_URL"|t, infoRefs.algorithmApiUrl, infoRefs.algorithmApiUrl, null, null, "SEARCH_DETAIL.ALG_HELP.API_URL.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.API_URL.MESSAGE"|t) }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_SOURCE_CODE_URL"|t, infoRefs.algorithmSourceCodeUrl, infoRefs.algorithmSourceCodeUrl, null, null, "SEARCH_DETAIL.ALG_HELP.SOURCE_CODE_URL.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.SOURCE_CODE_URL.MESSAGE"|t) }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_WEBSITE_URL"|t, infoRefs.algorithmWebsiteUrl, infoRefs.algorithmWebsiteUrl, null, null, "SEARCH_DETAIL.ALG_HELP.WEBSITE_URL.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.WEBSITE_URL.MESSAGE"|t) }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_EXAMPLE_URL"|t, infoRefs.algorithmExampleUrl, infoRefs.algorithmExampleUrl, null, null, "SEARCH_DETAIL.ALG_HELP.EXAMPLE_URL.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.EXAMPLE_URL.MESSAGE"|t) }}
        {{ hit_macros.render_label_link("SEARCH_DETAIL.ALG_PUBLICCODE_URL"|t, infoRefs.algorithmPubliccodeUrl, infoRefs.algorithmPubliccodeUrl, null, null, "SEARCH_DETAIL.ALG_HELP.PUBLICCODE_URL.TITLE"|t, "SEARCH_DETAIL.ALG_HELP.PUBLICCODE_URL.MESSAGE"|t) }}
        {% for data in infoRefs.algorithmAdditionalUrls %}
            {{ hit_macros.render_label_link(data.name, data.url, data.url) }}
        {% endfor %}
    </div>
{% endif %}